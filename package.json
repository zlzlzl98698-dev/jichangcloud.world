{
  "name": "jichangcloud.world",
  "version": "1.0.0",
  "description": "机场cloud - 高品质机场推荐、测速评测与科学上网客户端指南平台",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev src",
    "docs:build": "vitepress build src && npm run index:pagefind",
    "docs:preview": "vitepress preview src",
    "index:pagefind": "npx pagefind --site src/.vitepress/dist --output-path src/.vitepress/dist/pagefind"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "vitepress": "^1.5.0"
  }
}
